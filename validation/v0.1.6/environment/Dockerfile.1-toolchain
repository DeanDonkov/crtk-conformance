# dVRK 2.4.0 (ROS 1 Noetic, kinematic simulation) build toolchain on Ubuntu 20.04.
# Base: debootstrap --variant=minbase focal (archive.ubuntu.com), docker-imported as focal-minbase:dvrk.
FROM focal-minbase:dvrk
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN printf "deb http://archive.ubuntu.com/ubuntu focal main universe multiverse\ndeb http://archive.ubuntu.com/ubuntu focal-updates main universe multiverse\ndeb http://archive.ubuntu.com/ubuntu focal-security main universe multiverse\n" > /etc/apt/sources.list \
 && apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config ca-certificates curl gfortran \
    python3 python3-dev python3-pip python3-setuptools python3-wheel python3-numpy python3-yaml python3-empy \
    python3-nose python3-netifaces python3-defusedxml python3-psutil python3-docutils python3-dateutil \
    python3-pyparsing python3-six python3-distro python3-packaging python3-pyudev \
    libboost-all-dev libbz2-dev liblz4-dev libgpgme-dev libconsole-bridge-dev libpoco-dev \
    libtinyxml-dev libtinyxml2-dev liblog4cxx-dev libgtest-dev libeigen3-dev libyaml-cpp-dev \
    libraw1394-dev libncurses5-dev swig libcppunit-dev libhidapi-dev libxml2-dev libjsoncpp-dev \
    qtbase5-dev libqt5xmlpatterns5-dev libqt5opengl5-dev libqt5svg5-dev xvfb lsb-release \
 && rm -rf /var/lib/apt/lists/*
COPY wheels /tmp/wheels
RUN pip3 install --no-cache-dir --no-index --no-deps /tmp/wheels/* && rm -rf /tmp/wheels
# rostopic -> rosbag imports Cryptodome and gnupg (added after the 21 Sep feasibility run, which installed these two at container start)
COPY wheels38 /tmp/wheels38
RUN pip3 install --no-cache-dir --no-index --no-deps /tmp/wheels38/* && rm -rf /tmp/wheels38
